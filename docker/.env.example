# OrbitCloud Docker 部署 .env 示例
# 首次部署执行 prep.ps1 / prep.sh 会自动生成本文件(密钥随机)。
# 端口默认避开宿主机已占用(80=Gitea、445=系统 SMB),可自行修改。

# ---- 安全(必改/自动生成) ----
JWT_SECRET=please-change-me-64-chars-random-string-0123456789abcdef
SHARED_KEY=please-change-me-32-chars-random-string-0123456789

# ---- 存储凭据(与 rustfs 一致,生产必改) ----
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# ---- 端口映射(宿主:容器) ----
PORT_WEB=18080
PORT_SMB=1445
PORT_API=8080
PORT_S3=9000
