# ============================================================
#  OrbitCloud - SMB 网关高度定制版配置示例
#  (使用: docker run -v 本文件:/opt/orbitcloud/gateway/SMB.yaml)
#
#  机制说明: 容器启动时仅当网关配置不存在时用内置模板渲染;
#  挂载本文件后直接生效。★ shared_key 必须与后端配置
#  OrbitCloud.yaml 的 smb_gateway.shared_key 完全一致。
# ============================================================

# ------------------------------------------------------------
# 1. SMB 协议服务
# ------------------------------------------------------------
smb:
  # 监听地址: 端口(容器内 445, 对外用 docker -p 445:445 映射;
  # 若本机 445 被占用可改 1445 并用 -p 1445:445 对外)
  listen: "0.0.0.0:445"

  # NetBIOS 名称(Windows 网上邻居中显示的名字, ≤15 字符)
  netbios_name: "ORBITCLOUD"

# ------------------------------------------------------------
# 2. 与后端通信的网关通道
# ------------------------------------------------------------
gateway:
  # 后端地址(容器内固定 127.0.0.1:9101, 无需修改)
  addr: "127.0.0.1:9101"

  # 与后端共享的密钥(必改; 与 OrbitCloud.yaml 的 smb_gateway.shared_key 一致)
  shared_key: "REPLACE_ME_SAME_AS_ORBITCLOUD_YAML"

  # 共享密钥环境变量名(可选; 优先于 shared_key, 便于密钥不入文件)
  shared_key_env: ""

  # 心跳间隔(秒): 网关 → 后端保活
  heartbeat_secs: 30

  # 用户/共享列表同步间隔(秒): 后端变化多久同步到网关
  sync_interval_secs: 60

  # 通道缓冲大小(与后端 smb_gateway.channel_buffer 建议一致)
  channel_buffer: 1024

  # RPC 超时(秒): 网关调用后端接口的最长等待
  rpc_timeout_secs: 30

# ------------------------------------------------------------
# 3. 网关日志(写入 /data 卷, 与容器同生命周期)
# ------------------------------------------------------------
log:
  # 日志级别
  # 取值: debug | info | warn | error
  level: "info"

  # 日志输出目录(容器内, 建议落在 /data 卷便于排查)
  output: "/data/logs"

  # 日志文件名前缀
  file_prefix: "smb-gateway"

  # 是否入库(日志写入 SQLite 便于后端页面查询)
  db_enabled: true

  # 日志库路径(落在 /data 卷)
  db_path: "/data/logs/logs.db"

  # 入库日志级别
  db_level: "info"

  # 日志保留天数
  retention_days: 30

  # 清理任务执行间隔(秒)
  cleanup_interval_secs: 3600
