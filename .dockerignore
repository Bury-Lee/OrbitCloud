# ============================================================
#  .dockerignore —— 仓库根构建上下文过滤
#  build context 为仓库根, 排除与镜像无关的大文件/目录
#
#  ★注意: log/ 是 orbitcloud/log 源码包目录, 绝不能排除;
#          仅排除日志输出目录 logs/ 与 *.log 文件
#  ★规则: /xxx/ 前缀限定只匹配构建上下文根目录, 避免误伤 vendor/ 下同名目录
# ============================================================

.git
.gitignore
.github

# 本地/运行时生成
/data/
/logs/
**/logs/
data/
*.log
*.db
orbitcloud.exe
orbitcloud-linux
orbitcloud
orbitcloud.db
/.orbitcloud/
OrbitCloud.yaml
SMB.yaml

# 构建产物
dist/
build/dist/
**/target/
frontend/node_modules/
frontend/dist/

# 本地/临时
.vscode/
.idea/
.orb/

# ============================================================
#  以下为打包补充排除(构建不需要,减小 context 体积)
# ============================================================
/review-tmp/
/tem/
/test/
/other_software/
/build/
/tool/
/deploy/
/deploy-tool/
/docs/
/.alf/
/.VSCodeCounter/
docker/orbitcloud/bin/
docker/smb-gateway/bin/
docker/rustfs/bin/
docker/web/web/
docker/.env
*.tar
*.zip

# 注意: docker/(entrypoint/templates/nginx 配置)是 Dockerfile 构建输入,不能排除
